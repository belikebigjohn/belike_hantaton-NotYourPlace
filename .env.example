# Server configuration. Copy to .env; never put credentials in frontend code.
COOKIE_SECURE=0
DEMO_MODE=0
GEOCODER_ENABLED=0
# Photon can be selected by a person using the explicit in-app consent checkbox.
# Override that named provider with your own Photon server when required.
PHOTON_URL=https://photon.komoot.io/reverse
# Optional operator-configured provider (still requires per-request consent):
GEOCODER_PROVIDER=photon
GEOCODER_URL=
GEOCODER_USER_AGENT=ChuzhoeMesto/0.2
# COOKIE_SECURE=1 for HTTPS deployments; retain data only as needed.
