# Server configuration. Copy to .env; never put credentials in frontend code.
COOKIE_SECURE=0
DEMO_MODE=0
GEOCODER_ENABLED=0
# Photon endpoint is retained for legacy clients; current UI names Nominatim.
# Override that named provider with your own Photon server when required.
PHOTON_URL=https://photon.komoot.io/reverse
# Current UI: user-approved Nominatim, called only after per-request consent.
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
# Optional operator-configured provider (still requires per-request consent):
GEOCODER_PROVIDER=photon
GEOCODER_URL=
GEOCODER_USER_AGENT=ChuzhoeMesto/0.2
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000,https://gosdyma.ru
# Public browser JS API key; restrict HTTP Referers in Yandex developer console.
YANDEX_MAPS_API_KEY=
# The project proxy marks external HTTPS requests; keep 0 for local HTTP access.
# Use COOKIE_SECURE=1 only when every browser entry point is HTTPS.
# MAX bot integration. Keep values only in the ignored .env file.
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=
MAX_WEBHOOK_SECRET=
